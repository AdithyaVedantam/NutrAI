# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=paste-a-long-random-string-here
# Google AI Studio key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional: models tried in order if one is busy/unavailable. Leave commented to use the built-in chain.
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-3.7-flash
FRONTEND_URL=http://localhost:3000
PORT=4000
